{
  "name": "webgl-shader-playground",
  "version": "1.0.0",
  "description": "Test shaders offline with just a browser",
  "scripts": {
    "setup": "npm ci",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prebuild": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\"",
    "build": "rolldown -c",
    "size": "node scripts/check-size.ts",
    "test:e2e": "playwright test",
    "typecheck:e2e": "tsc -p tests/e2e/tsconfig.json --noEmit",
    "dev": "rolldown -c -w"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dli7319/webgl-shader-playground.git"
  },
  "author": "dli7319",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "overrides": {
    "dompurify": "^3.4.16",
    "postcss-selector-parser": "^7.1.6"
  },
  "bugs": {
    "url": "https://github.com/dli7319/webgl-shader-playground/issues"
  },
  "homepage": "https://github.com/dli7319/webgl-shader-playground#readme",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.0",
    "@testing-library/preact": "^3.2.4",
    "@types/node": "^26.6.5",
    "@types/three": "^0.186.0",
    "@vitest/coverage-v8": "^5.0.3",
    "eslint": "^10.12.0",
    "globals": "^17.13.0",
    "jsdom": "^30.1.2",
    "postcss": "^8.5.29",
    "prettier": "^3.9.9",
    "rolldown": "^1.2.13",
    "rollup-plugin-copy": "^3.5.0",
    "rollup-plugin-postcss": "^4.0.2",
    "rollup-plugin-serve": "^3.0.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.71.1",
    "vitest": "^5.0.3"
  },
  "dependencies": {
    "@monaco-editor/react": "^4.7.0",
    "monaco-editor": "^0.57.0",
    "preact": "^11.0.1",
    "three": "^0.186.1"
  }
}
